/** @Chaos.Fault.Strategy — answers a failure instead of running the callback */
module PuduLangResilience.Chaos.Fault

import PuduLangResilience.Chaos as Chaos
import PuduLangResilience.Constants.Events as Events
import PuduLangResilience.Context as Context
import PuduLangResilience as Resilience
import PuduLangResilience.Strategy as Strategy
import PuduLangResilience.Telemetry as Telemetry

/** @Chaos.Fault.Injected — the failure injected into one execution */
export type Injected[E] = { context: Context.Context, failure: Resilience.Failure[E] }

/** @Chaos.Fault.Options — which failure to inject and how often */
export type Options[E] = {
  name: Option[Str],
  injection: Chaos.Injection,
  fault: Option[Resilience.Failure[E]],
  generator: Option[fn(Chaos.Arguments) -> Option[Resilience.Failure[E]]],
  onInjected: Option[fn(Injected[E]) -> ()]
}

/// The default injection with no failure chosen yet.
export fn defaults[E]() -> Options[E] { Options{name: None, injection: Chaos.defaults(), fault: None, generator: None, onInjected: None} }

/// Injects `failure` at the given injection settings.
export fn injecting[E](failure: Resilience.Failure[E], injection: Chaos.Injection) -> Options[E] {
  Options{..defaults(), injection: injection, fault: Some(failure)}
}

/// Every reason the options cannot be followed.
export fn validate[E](options: &Options[E]) -> Array[Str] {
  var problems = Chaos.validate(&options.injection)
  if options.fault == None && options.generator == None { problems = problems.push("a fault or a generator is required") }
  problems
}

/// A fault injection strategy following the options. The generator is used when given; a
/// generator answering nothing injects nothing.
export fn strategy[T, E](options: Options[E]) -> Strategy.Strategy[T, E] {
  Strategy.Strategy {
    name: options.name,
    kind: "ChaosFault",
    summary: "injects a fault at rate " + show(options.injection.rate),
    problems: validate(&options),
    attach: Strategy.detached,
    execute: fn(runtime: Strategy.Runtime, context: Context.Context, callback: Strategy.Callback[T, E]) -> Resilience.Outcome[T, E] {
      if !Chaos.shouldInject(&options.injection, &context, &runtime.randomizer) { return callback(context) }
      let chosen = match options.generator {
        case Some(generate) => generate(Chaos.arguments(&context, &runtime.randomizer))
        case None => options.fault
      }
      match chosen {
        case Some(failure) => {
          Telemetry.report(&runtime.telemetry, &context, Events.ON_FAULT, Telemetry.Information, Some(Resilience.describe(&failure)), Telemetry.FaultInjected)
          if let Some(notify) = options.onInjected { notify(Injected{context: context, failure: failure}) }
          Err(failure)
        }
        case None => callback(context)
      }
    }
  }
}
